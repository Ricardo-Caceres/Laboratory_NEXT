# Vercel Deployment Configuration

# Project Settings
project: devkit-laboratory

# Build Settings
buildCommand: yarn build
outputDirectory: .next
installCommand: yarn install

# Environment Variables
# Add these in Vercel Dashboard:
# - NODE_VERSION=22
# - NEXT_PUBLIC_APP_URL (your production URL)

# Framework Detection
framework: nextjs

# Node.js Version
nodeVersion: 22

# Regions (Optional - choose closest to your users)
# regions:
#   - iad1  # US East
#   - sfo1  # US West

# Headers
headers:
  - source: /(.*)?
    headers:
      - key: X-Content-Type-Options
        value: nosniff
      - key: X-Frame-Options
        value: DENY
      - key: X-XSS-Protection
        value: 1; mode=block
      - key: Referrer-Policy
        value: origin-when-cross-origin

# Redirects (if needed)
# redirects:
#   - source: /old-path
#     destination: /new-path
#     permanent: true

# Ignored Build Step (for preview deployments)
# This ensures builds only run when necessary
ignoreCommand: |
  bash -c '[[ "$VERCEL_GIT_COMMIT_REF" != "main" ]] && [[ "$VERCEL_GIT_COMMIT_REF" != "develop" ]]'
