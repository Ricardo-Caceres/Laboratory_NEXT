## 📝 Reglas de Código

### TypeScript
```typescript
// ✅ HACER
interface UserProps {
  id: string;
  name: string;
  email?: string;
}

const getUser = async (id: string): Promise<User> => {
  // implementation
};

// ❌ EVITAR
const getUser = (id: any) => {
  // no types
};
```

### React Components
```typescript
// ✅ HACER - Functional Component con TypeScript
interface ButtonProps {
  label: string;
  onClick: () => void;
  variant?: 'primary' | 'secondary';
}

export const Button = ({ label, onClick, variant = 'primary' }: ButtonProps) => {
  return (
    <button 
      onClick={onClick}
      className={`btn btn-${variant}`}
    >
      {label}
    </button>
  );
};

// ❌ EVITAR - Props sin tipos
export const Button = ({ label, onClick }) => {
  // sin tipos
};
```

### Server Components (Next.js 15)
```typescript
// ✅ HACER - Server Component por defecto
export default async function Page() {
  const data = await fetchData();
  return <div>{data}</div>;
}

// ✅ HACER - Client Component cuando sea necesario
'use client';
import { useState } from 'react';

export default function InteractiveComponent() {
  const [count, setCount] = useState(0);
  return <button onClick={() => setCount(count + 1)}>{count}</button>;
}
```

### Custom Hooks
```typescript
// ✅ HACER - Hook reutilizable con tipos
interface UseToggleReturn {
  isOn: boolean;
  toggle: () => void;
  setOn: () => void;
  setOff: () => void;
}

export const useToggle = (initialValue = false): UseToggleReturn => {
  const [isOn, setIsOn] = useState(initialValue);
  
  const toggle = useCallback(() => setIsOn(prev => !prev), []);
  const setOn = useCallback(() => setIsOn(true), []);
  const setOff = useCallback(() => setIsOn(false), []);
  
  return { isOn, toggle, setOn, setOff };
};
```

### Estado y Side Effects
```typescript
// ✅ HACER - useEffect con dependencias correctas
useEffect(() => {
  const controller = new AbortController();
  
  fetchData(id, controller.signal)
    .then(setData)
    .catch(error => {
      if (error.name !== 'AbortError') {
        setError(error);
      }
    });
    
  return () => controller.abort();
}, [id]);

// ❌ EVITAR - useEffect sin cleanup o dependencias incorrectas
useEffect(() => {
  fetchData(id).then(setData);
}, []); // falta dependencia 'id'
```

## 🎨 Patrones de Diseño

### Compound Components
```typescript
// ✅ HACER - Componentes compuestos con Context
const TabsContext = createContext<TabsContextValue | null>(null);

export const Tabs = ({ children }: { children: ReactNode }) => {
  const [activeTab, setActiveTab] = useState(0);
  
  return (
    <TabsContext.Provider value={{ activeTab, setActiveTab }}>
      {children}
    </TabsContext.Provider>
  );
};

Tabs.List = TabsList;
Tabs.Tab = Tab;
Tabs.Panel = TabPanel;
```

### Container/Presentational
```typescript
// ✅ HACER - Separar lógica de presentación

// Container (lógica)
const UserProfileContainer = () => {
  const { user, loading } = useUser();
  
  if (loading) return <Spinner />;
  
  return <UserProfileView user={user} />;
};

// Presentational (UI)
interface UserProfileViewProps {
  user: User;
}

const UserProfileView = ({ user }: UserProfileViewProps) => (
  <div className="user-profile">
    <h1>{user.name}</h1>
    <p>{user.email}</p>
  </div>
);
```

## 🚀 Performance

### Optimización de Renders
```typescript
// ✅ HACER - Memoización cuando sea necesario
const ExpensiveComponent = memo(({ data }: Props) => {
  return <div>{/* expensive render */}</div>;
});

const handleClick = useCallback(() => {
  // handle click
}, [dependency]);

const expensiveValue = useMemo(() => {
  return computeExpensiveValue(data);
}, [data]);
```

### Code Splitting
```typescript
// ✅ HACER - Dynamic imports
const DynamicComponent = dynamic(() => import('./HeavyComponent'), {
  loading: () => <Spinner />,
  ssr: false
});
```

## 🧪 Testing (Preparar para implementación futura)

### Estructura de Tests
```typescript
// ✅ HACER - Tests descriptivos y aislados
describe('useToggle', () => {
  it('should initialize with false by default', () => {
    const { result } = renderHook(() => useToggle());
    expect(result.current.isOn).toBe(false);
  });
  
  it('should toggle the value', () => {
    const { result } = renderHook(() => useToggle());
    act(() => result.current.toggle());
    expect(result.current.isOn).toBe(true);
  });
});
```

## 📋 Checklist de Code Review

### Antes de Commit
- [ ] Código sigue principios SOLID
- [ ] Nombres descriptivos y claros
- [ ] Sin código duplicado (DRY)
- [ ] Tipos TypeScript correctos (no `any`)
- [ ] Props y retornos tipados
- [ ] useEffect con dependencias correctas
- [ ] Cleanup en useEffect cuando necesario
- [ ] Memoización apropiada (no excesiva)
- [ ] Componentes pequeños y enfocados
- [ ] Accesibilidad básica (aria-labels cuando corresponda)
- [ ] No hay console.logs (usar debugging apropiado)
- [ ] ESLint sin errores
- [ ] Build exitoso (`yarn build`)

### Seguridad
- [ ] No exponer secrets o API keys
- [ ] Validar inputs de usuario
- [ ] Sanitizar datos antes de renderizar
- [ ] HTTPS para llamadas API
- [ ] Manejar errores apropiadamente

## 🎯 Mejores Prácticas Next.js 15

### App Router
```typescript
// ✅ HACER - Usar metadata API
export const metadata: Metadata = {
  title: 'Page Title',
  description: 'Page description',
};

// ✅ HACER - Server Components por defecto
export default async function Page() {
  const data = await fetchData(); // Fetch directo en server
  return <Component data={data} />;
}

// ✅ HACER - Loading states
export default function Loading() {
  return <Skeleton />;
}

// ✅ HACER - Error boundaries
export default function Error({ error, reset }: ErrorProps) {
  return <ErrorComponent error={error} retry={reset} />;
}
```

### Imágenes
```typescript
// ✅ HACER - Next.js Image component
import Image from 'next/image';

<Image
  src="/image.jpg"
  alt="Description"
  width={500}
  height={300}
  priority // para LCP
/>
```

